agent_version() {
  grep 'tested_version:' "$ROOT_DIR/versions.yaml" | head -1 | sed -E 's/.*"([^"]+)".*/\1/'
}

agent_help() {
  cat <<EOF
agent — single entry point for the DeepSeek Harness + Claude Code + Codex stack

Usage:
  agent                        Run in the current directory; prompts for a task
  agent .                      Same as above, explicit path
  agent /path/to/repo          Run in another project directory
  agent /path/to/repo "task"   Run a specific task non-interactively
  agent doctor [/path]         Run environment/setup checks (see README)
  agent --help                 Show this message
  agent --version              Show this stack's tested version pins

Operational commands (P2 — never call an LLM):
  agent status [/path]         Project, active run, lock, provider status
  agent runs [/path]           List recorded runs for a project
  agent show <run-id>          Sanitized summary of one run
  agent logs <run-id> [--json] Structured events for one run
  agent resume <run-id> [--force]
                                Resume an interrupted run at its last safe
                                checkpoint (never continues a Claude/Codex
                                session directly — see README "Recovery")
  agent cancel <run-id>        Request cancellation of an active run
  agent unlock [/path]         Force-remove a workspace lock (see doctor first)
  agent cleanup [/path]        Apply run retention (policies/runtime.yaml)

Maintenance commands (P3 — 'check'/'plan'/'inventory'/'benchmark --offline'/
'backup'/'release'/'memexp' make ZERO changes and ZERO LLM calls):
  agent inventory [--json]     Installed vs tested versions + capability status
  agent update check           Discover newer published versions (read-only)
  agent update plan [<comp>]   Show exactly what an update would do (read-only)
  agent update apply <comp> [--to <v>] [--yes]
                                Snapshot -> stage -> verify -> apply -> post-verify
  agent update rollback [<snapshot-id>]
                                Restore config from a pre-update snapshot
  agent benchmark [--offline|--live|compare <a> <b>]
                                Deterministic (offline) or real (live) quality/
                                cost benchmark; compare detects regressions
  agent backup [--out <path>] / agent restore <archive> [--yes]
                                Portable stack-config backup (no secrets/projects)
  agent release [list|show <v>|create <v>|verify <v>]
                                Known-good stack manifests (reproducible install)
  agent memexp [report|...]     Opt-in claude-mem cost experiment (never switches)
  agent --profile economy|balanced|strict <task...>
                                Run under an optimization profile (default: balanced)
  agent --engine legacy|dsh [--tool-mode native|auto|programmatic] <path> <task>
                                Select the hybrid engine. legacy remains the default.
  agent profile [/path]        Show the active optimization profile

If no task text is given, agent reads one line from stdin when input is
piped, or prompts interactively when attached to a terminal.

What it does: resolves the workspace, sends the task to the 'lead' DSH
profile (Claude Code, real write/edit access), collects git status/diff,
runs the project's own test/lint/typecheck, sends an independent review
package to the 'reviewer' DSH profile (Codex, mechanism-enforced
read-only), and — if Codex reports a blocking finding — sends it back to
Claude for up to 2 correction rounds (policies/orchestration.yaml). It
never runs git push, git commit, or a deploy command on its own.
EOF
}

agent_read_task_interactively() {
  if [ -t 0 ]; then
    local task
    read -r -p "Task: " task
    printf '%s' "$task"
  else
    cat
  fi
}

main() {
  # P3.14: pull a global --profile <name> / --profile=<name> out of the
  # args from anywhere before dispatching. Exported so lib/context.sh and
  # lib/risk.sh (via lib/profiles.sh) pick it up.
  local -a _args=() _a
  local engine_cli="" tool_mode_cli=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) shift; AGENT_PROFILE="${1:-}"; export AGENT_PROFILE; shift || true ;;
      --profile=*) AGENT_PROFILE="${1#--profile=}"; export AGENT_PROFILE; shift ;;
      --engine) shift; engine_cli="${1:-}"; shift || true ;;
      --engine=*) engine_cli="${1#--engine=}"; shift ;;
      --tool-mode) shift; tool_mode_cli="${1:-}"; shift || true ;;
      --tool-mode=*) tool_mode_cli="${1#--tool-mode=}"; shift ;;
      --programmatic) tool_mode_cli="programmatic"; shift ;;
      *) _args+=("$1"); shift ;;
    esac
  done
  set -- "${_args[@]+"${_args[@]}"}"
  if [ -n "${AGENT_PROFILE:-}" ] && ! profile_is_valid "$AGENT_PROFILE"; then
    echo "error: unknown --profile '$AGENT_PROFILE' (valid: $PROFILE_NAMES)" >&2
    exit 2
  fi

  case "${1:-}" in
    --help|-h)
      agent_help
      exit 0
      ;;
    profile)
      shift
      local pws
      pws="$(project_resolve_workspace "${1:-.}" 2>/dev/null || echo "")"
      profile_describe "$pws"
      exit 0
      ;;
    --version|-v)
      echo "agent (this stack): $(agent_version)"
      exit 0
      ;;
    doctor)
      shift
      exec "$ROOT_DIR/scripts/doctor.sh" "$@"
      ;;
    status)
      shift
      local ws
      ws="$(project_resolve_workspace "${1:-.}")" || exit 1
      run_cli_status "$ws"
      exit 0
      ;;
    runs)
      shift
      local ws
      ws="$(project_resolve_workspace "${1:-.}")" || exit 1
      run_cli_runs "$ws"
      exit 0
      ;;
    show)
      shift
      if [ -z "${1:-}" ]; then echo "usage: agent show <run-id>" >&2; exit 1; fi
      run_cli_show "$1"
      exit $?
      ;;
    logs)
      shift
      if [ -z "${1:-}" ]; then echo "usage: agent logs <run-id> [--json]" >&2; exit 1; fi
      run_cli_logs "$1" "${2:-}"
      exit $?
      ;;
    resume)
      shift
      if [ -z "${1:-}" ]; then echo "usage: agent resume <run-id> [--force]" >&2; exit 1; fi
      local rid="$1" force=false
      shift
      [ "${1:-}" = "--force" ] && force=true
      resume_run "$rid" "$force"
      exit $?
      ;;
    cancel)
      shift
      if [ -z "${1:-}" ]; then echo "usage: agent cancel <run-id>" >&2; exit 1; fi
      run_cli_cancel "$1"
      exit $?
      ;;
    unlock)
      shift
      local ws
      ws="$(project_resolve_workspace "${1:-.}")" || exit 1
      run_cli_unlock "$ws"
      exit 0
      ;;
    cleanup)
      shift
      local ws=""
      if [ -n "${1:-}" ]; then
        ws="$(project_resolve_workspace "$1")" || exit 1
      fi
      cleanup_apply_retention "$ws"
      exit 0
      ;;
    update)
      shift
      update_cli_dispatch "$@"
      exit $?
      ;;
    inventory)
      shift
      [ "${1:-}" = "--json" ] && { inventory_json --probe; echo; exit 0; }
      inventory_print --probe
      exit 0
      ;;
    benchmark)
      shift
      case "${1:-}" in
        --offline|"") benchmark_suite --offline; exit $? ;;
        --live)
          echo "WARNING: 'agent benchmark --live' runs every fixture through the real Claude and Codex profiles and spends usage." >&2
          if [ -t 0 ]; then printf 'continue? [y/N] ' >&2; read -r r; case "$r" in y|Y|yes) ;; *) echo "aborted."; exit 1 ;; esac
          elif [ "${AGENT_BENCHMARK_LIVE_YES:-}" != "1" ]; then echo "refusing to run --live non-interactively without AGENT_BENCHMARK_LIVE_YES=1" >&2; exit 1; fi
          benchmark_suite --live; exit $? ;;
        compare)
          shift
          [ -n "${1:-}" ] && [ -n "${2:-}" ] || { echo "usage: agent benchmark compare <baseline.json> <candidate.json>" >&2; exit 2; }
          benchmark_compare "$1" "$2"; exit $? ;;
        *) echo "usage: agent benchmark [--offline|--live|compare <a> <b>]" >&2; exit 2 ;;
      esac
      ;;
    backup)
      shift
      case "${1:-}" in
        list) backup_list; exit 0 ;;
        *) backup_create "$@"; exit $? ;;
      esac
      ;;
    restore)
      shift
      [ -n "${1:-}" ] || { echo "usage: agent restore <backup.tar.gz> [--yes]" >&2; exit 2; }
      backup_restore "$@"; exit $?
      ;;
    release)
      shift
      case "${1:-}" in
        list|"") release_list; exit 0 ;;
        show) shift; release_show "${1:-}"; exit $? ;;
        create) shift; release_create "$@"; exit $? ;;
        verify) shift; release_verify "${1:-}"; exit $? ;;
        *) echo "usage: agent release [list|show <v>|create <v>|verify <v>]" >&2; exit 2 ;;
      esac
      ;;
    memexp)
      shift
      case "${1:-}" in
        baseline|"") memexp_baseline; exit 0 ;;
        facts) memexp_facts; exit 0 ;;
        queries) memexp_queries; exit 0 ;;
        score) shift; memexp_score "${1:-}"; exit $? ;;
        compare) shift; memexp_compare "${1:-}" "${2:-}"; exit $? ;;
        report) memexp_report; exit 0 ;;
        *) echo "usage: agent memexp [baseline|facts|queries|score <f>|compare <b> <c>|report]" >&2; exit 2 ;;
      esac
      ;;
  esac

  local workspace_arg="." task=""
  if [ $# -gt 0 ]; then
    if [ -d "$1" ]; then
      workspace_arg="$1"
      shift
      task="$*"
    else
      task="$*"
    fi
  fi

  local workspace
  if ! workspace="$(project_resolve_workspace "$workspace_arg")"; then
    exit 1
  fi

  if [ -z "$task" ]; then
    task="$(agent_read_task_interactively)"
  fi
  if [ -z "$(printf '%s' "$task" | tr -d '[:space:]')" ]; then
    echo "error: no task provided" >&2
    exit 1
  fi

  echo "workspace: $workspace"
  orchestrate_run "$workspace" "$task" "$engine_cli" "$tool_mode_cli"
}

main "$@"
