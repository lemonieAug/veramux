#!/usr/bin/env bash
# Mock `dsh` used by tests/unit/*.sh to exercise bin/agent's orchestration
# loop deterministically, without a real DeepSeek Harness / Claude Code /
# Codex install and without spending any quota. Behavior selected by
# $MOCK_DSH_MODE. This is a test fixture, never referenced from bin/, lib/,
# or scripts/ — it is not part of the production path.
set -euo pipefail

profile=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) profile="$2"; shift 2 ;;
    --version) echo "dsh/mock 0.0.0-test"; exit 0 ;;
    *) shift ;;
  esac
done

fixed_add() {
  cat > add.js <<'JS'
function add(a, b) {
  if (a < 0 || b < 0) {
    throw new Error('negative numbers are not allowed');
  }
  return a + b;
}
module.exports = { add };
JS
}

broken_add() {
  cat > add.js <<'JS'
function add(a, b) {
  return a + b;
}
module.exports = { add };
JS
}

case "${MOCK_DSH_MODE:-}" in
  happy)
    if [ "$profile" = "lead" ]; then
      fixed_add
      echo "Implemented negative-number validation in add.js."
    elif [ "$profile" = "reviewer" ]; then
      echo '{"verdict":"approved","summary":"Matches the objective, tests pass.","findings":[]}'
    fi
    ;;

  docs_only)
    if [ "$profile" = "lead" ]; then
      echo "# Notes" > NOTES.md
      echo "Added docs."
    elif [ "$profile" = "reviewer" ]; then
      echo '{"verdict":"approved","summary":"n/a","findings":[]}'
    fi
    ;;

  changes_then_approve)
    if [ "$profile" = "lead" ]; then
      if [ -f .round ]; then
        fixed_add
        echo "Applied the reviewer's requested fix."
      else
        : > .round
        broken_add
        echo "Initial (incomplete) implementation."
      fi
    elif [ "$profile" = "reviewer" ]; then
      if [ -f .reviewed ]; then
        echo '{"verdict":"approved","summary":"Fixed.","findings":[]}'
      else
        : > .reviewed
        echo '{"verdict":"changes_requested","summary":"Missing validation.","findings":[{"severity":"high","category":"correctness","file":"add.js","line":1,"problem":"No negative-number check","reason":"Task requires rejecting negative inputs","recommendation":"Add a guard clause that throws on negative a or b"}]}'
      fi
    fi
    ;;

  high_risk_no_explicit_approval)
    if [ "$profile" = "lead" ]; then
      mkdir -p src/auth
      echo "// updated" >> src/auth/login.js
      echo "Implemented the auth change."
    elif [ "$profile" = "reviewer" ]; then
      echo '{"verdict":"changes_requested","summary":"looks fine but no explicit approval","findings":[]}'
    fi
    ;;

  invalid_json_once)
    if [ "$profile" = "lead" ]; then
      fixed_add
      echo "Implemented."
    elif [ "$profile" = "reviewer" ]; then
      if [ -f .retried ]; then
        echo '{"verdict":"approved","summary":"ok","findings":[]}'
      else
        : > .retried
        echo 'not valid json at all'
      fi
    fi
    ;;

  invalid_json_twice)
    if [ "$profile" = "lead" ]; then
      fixed_add
      echo "Implemented."
    elif [ "$profile" = "reviewer" ]; then
      echo 'still not valid json'
    fi
    ;;

  never_approves)
    if [ "$profile" = "lead" ]; then
      broken_add
      echo "attempt"
    elif [ "$profile" = "reviewer" ]; then
      echo '{"verdict":"changes_requested","summary":"still broken","findings":[{"severity":"critical","category":"correctness","file":"add.js","line":1,"problem":"still no negative check","reason":"task requirement","recommendation":"add the guard"}]}'
    fi
    ;;

  resume_correction_fix)
    # P2.10 resume test fixture: simulates "Claude fixes it during a
    # RESUMED correction call, then Codex approves" — deliberately
    # stateless (no .round/.reviewed markers) since a resume test fabricates
    # the pre-interruption state directly rather than replaying earlier
    # calls through this mock.
    if [ "$profile" = "lead" ]; then
      fixed_add
      echo "Applied the fix during resumed correction."
    elif [ "$profile" = "reviewer" ]; then
      echo '{"verdict":"approved","summary":"Fixed after resumed correction.","findings":[]}'
    fi
    ;;

  quota_unavailable)
    # P2.19 Scenario C: Codex has no quota. Lead succeeds normally; the
    # reviewer call fails with a quota-shaped message on stderr and a
    # nonzero exit — review must NOT become "approved" as a result.
    if [ "$profile" = "lead" ]; then
      fixed_add
      echo "Implemented."
    elif [ "$profile" = "reviewer" ]; then
      echo "Error: insufficient_quota — Codex usage limit reached for this billing period." >&2
      exit 1
    fi
    ;;

  auth_failure)
    # P2.19: Claude's own auth/session is invalid. Exit nonzero with an
    # authentication-shaped stderr message.
    if [ "$profile" = "lead" ]; then
      echo "Error: Unauthorized (401) — please log in again." >&2
      exit 1
    elif [ "$profile" = "reviewer" ]; then
      echo '{"verdict":"approved","summary":"n/a","findings":[]}'
    fi
    ;;

  hang)
    # P2.19 Scenario B: the child never returns on its own — proves our
    # OWN wall-clock timeout (lib/proc_timeout.sh), not dsh, is what ends
    # it, and that nothing is left running afterward (no orphan process).
    if [ -n "${HANG_PID_FILE:-}" ]; then
      echo "$$" > "$HANG_PID_FILE"
    fi
    sleep 999999
    ;;

  lead_unreachable)
    echo "simulated lead outage" >&2
    exit 1
    ;;

  reviewer_unreachable)
    if [ "$profile" = "lead" ]; then
      fixed_add
      echo "Implemented."
    else
      echo "simulated reviewer outage" >&2
      exit 1
    fi
    ;;

  *)
    echo "mock-dsh: unknown MOCK_DSH_MODE='${MOCK_DSH_MODE:-}'" >&2
    exit 1
    ;;
esac
